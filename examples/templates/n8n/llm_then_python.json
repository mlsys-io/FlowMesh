    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import json\nimport os\nfrom pathlib import Path\n\n\ndef main(inputs):\n    \"\"\"Turn the LLM's outline into a Markdown report artifact.\n\n    Upstream stages arrive through ``inputs``: each is keyed by its node name\n    and exposes the stage's result as ``.output`` and its files as\n    ``.artifacts``. n8n's $input / items do not exist here.\n    \"\"\"\n    outline = str(inputs[\"Write Outline\"].output[\"items\"][0][\"output\"]).strip()\n    out = Path(os.environ[\"FLOWMESH_OUTPUT\"])\n    out.mkdir(parents=True, exist_ok=True)\n    lines = [line.strip(\"-* \").strip() for line in outline.splitlines() if line.strip()]\n    report = \"# Outline\\n\\n\" + \"\\n\".join(f\"{i}. {line}\" for i, line in enumerate(lines, 1))\n    (out / \"report.md\").write_text(report + \"\\n\")\n    return {\"sections\": len(lines), \"report\": \"report.md\", \"metrics\": {\"sections\": len(lines)}}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
